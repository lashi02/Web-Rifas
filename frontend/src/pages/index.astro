---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../layouts/Header/index.astro';
import Footer from '../layouts/Footer/index.astro';
import { supabase } from '../lib/supabase';
import type { Raffle } from '../types';
import { mockActiveRaffles } from './_ActiveRaffles/config/active-raffles.config';
import {
  Hero,
  FeaturedRaffle,
  ActiveRaffles,
  HowItWorks,
  Trust,
  WinnersHome,
  SocialImpact,
} from './_index';

const { data: raffles } = supabase
  ? await supabase
      .from('raffles')
      .select('*')
      .eq('status', 'active')
      .order('created_at', { ascending: false })
  : { data: null };

const rafflesToShow = (raffles?.length ? raffles : mockActiveRaffles) as Raffle[];
const featuredRaffle = rafflesToShow[0];
---

<Layout title="Inicio - Rifas Premium">
  <Header />

  <main>
    <Hero />
    {featuredRaffle && <FeaturedRaffle raffle={featuredRaffle} />}
    <ActiveRaffles raffles={rafflesToShow} />
    <HowItWorks />
    <Trust />
    <WinnersHome />
    <SocialImpact />
  </main>

  <Footer />
</Layout>
