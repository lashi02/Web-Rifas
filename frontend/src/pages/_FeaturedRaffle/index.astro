---
import CountdownTimer from '../../components/ui/CountdownTimer';
import type { Raffle } from '../../types';

interface Props {
  raffle: Raffle;
}

const { raffle } = Astro.props;
const percentage = (raffle.sold_tickets / raffle.total_tickets) * 100;
---

<section class="bg-dark-card py-12">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="card-premium overflow-hidden">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="relative overflow-hidden">
          <img
            src={raffle.image_url}
            alt={raffle.title}
            class="h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-dark/80 to-transparent"></div>
          <span class="absolute top-4 left-4 rounded-full border border-gold/30 bg-gold/20 px-3 py-1 text-xs font-semibold text-gold">
            Rifa Destacada
          </span>
        </div>

        <div class="flex flex-col justify-center p-6">
          <h2 class="mb-2 text-2xl font-bold text-white sm:text-3xl">{raffle.title}</h2>
          <p class="mb-6 text-neutral-400">{raffle.description}</p>

          <div class="mb-6">
            <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-gold">Tiempo restante</p>
            <CountdownTimer targetDate={raffle.draw_date} client:load />
          </div>

          <div class="mb-6">
            <div class="mb-2 flex items-center justify-between text-sm">
              <span class="text-neutral-400">{raffle.sold_tickets} / {raffle.total_tickets} vendidos</span>
              <span class="font-semibold text-gold">{percentage.toFixed(0)}%</span>
            </div>
            <div class="h-3 overflow-hidden rounded-full bg-dark-border">
              <div
                class="h-full rounded-full bg-gradient-to-r from-gold-dark via-gold to-gold-light transition-all duration-500"
                style={`width: ${percentage}%`}
              >
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-neutral-500">Precio por número</p>
              <p class="text-3xl font-bold text-gold">${raffle.ticket_price.toFixed(2)}</p>
            </div>
            <a
              href={`/raffles/${raffle.id}`}
              class="rounded-lg bg-gold px-6 py-3 font-bold text-dark transition-colors hover:bg-gold-light"
            >
              Participar
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
