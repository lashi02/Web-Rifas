---
import RaffleCard from '../raffles/_components/RaffleCard/index.astro';
import { activeRafflesContent, mockActiveRaffles } from './config/active-raffles.config';
import type { Raffle } from '../../types';

interface Props {
  raffles?: Raffle[];
}

const rafflesToShow = Astro.props.raffles?.length ? Astro.props.raffles : mockActiveRaffles;
---

<section class="bg-dark py-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 class="mb-8 text-center text-3xl font-bold text-white">{activeRafflesContent.title}</h2>

    {rafflesToShow.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {rafflesToShow.map((raffle) => (
          <RaffleCard raffle={raffle} />
        ))}
      </div>
    ) : (
      <p class="text-center text-neutral-500">{activeRafflesContent.emptyMessage}</p>
    )}
  </div>
</section>
