---
export const prerender = true;

import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminReservationsPage from './_Reservations/components/AdminReservationsPage';
import { reservations } from './_Reservations/config/reservations.config';

const pending = reservations.filter(r => r.status === 'pending');
---

<AdminLayout title="Todas las Reservas - Admin" active="reservations" reservationsCount={pending.length}>
  <AdminReservationsPage initialReservations={reservations} client:load />
</AdminLayout>
