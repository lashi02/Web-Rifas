---
export const prerender = true;import AdminLayout from '../../layouts/AdminLayout.astro';
import ReservationActions from './_Reservations/components/ReservationActions';
import { pendingReservations, recentActivity, stats } from './_Reservations/config/reservations.config';
---

<AdminLayout title="Panel de Administración" active="dashboard" reservationsCount={pendingReservations.length}>

  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-white">Dashboard</h1>
      <p class="text-neutral-400">Resumen general de la plataforma</p>
    </div>
    <a
      href="/admin/reservations"
      class="inline-flex items-center gap-2 rounded-lg bg-gold px-5 py-2.5 text-sm font-semibold text-dark transition-colors hover:bg-gold-light"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      Ver Reservas
    </a>
  </div>

  <div class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="card-premium p-5">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-neutral-500">Rifas Activas</p>
          <p class="text-3xl font-bold text-white">{stats.activeRaffles}</p>
        </div>
        <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-gold/10">
          <svg class="h-6 w-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
          </svg>
        </div>
      </div>
    </div>

    <a href="/admin/reservations?tab=pending" class="card-premium block p-5 transition-colors hover:border-gold/50">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-neutral-500">Reservas Pendientes</p>
          <p class="text-3xl font-bold text-amber">{stats.pendingReservations}</p>
        </div>
        <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-amber/10">
          <svg class="h-6 w-6 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
      </div>
    </a>

    <div class="card-premium p-5">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-neutral-500">Vendidos Hoy</p>
          <p class="text-3xl font-bold text-green">{stats.soldToday}</p>
        </div>
        <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-green/10">
          <svg class="h-6 w-6 text-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
      </div>
    </div>

    <div class="card-premium p-5">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-neutral-500">Ingresos Estimados</p>
          <p class="text-3xl font-bold text-gold">{stats.estimatedRevenue}</p>
        </div>
        <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-gold/10">
          <svg class="h-6 w-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <div class="card-premium">
      <div class="flex items-center justify-between border-b border-dark-border p-5">
        <h2 class="font-bold text-white">Reservas Pendientes</h2>
        <a href="/admin/reservations" class="text-sm text-gold hover:text-gold-light">Ver todas</a>
      </div>
      <div class="divide-y divide-dark-border">
        {pendingReservations.map((res) => (
          <div class="flex items-center justify-between p-4 transition-colors hover:bg-dark-hover">
            <a href={`/admin/reservations?tab=pending&search=${encodeURIComponent(res.name)}`} class="flex items-center gap-3 flex-1 min-w-0">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-amber/20 text-sm font-bold text-amber">
                {res.name.charAt(0)}
              </div>
              <div>
                <p class="font-medium text-white">{res.name}</p>
                <p class="text-xs text-neutral-500">{res.raffle} · {res.time}</p>
                <p class="text-xs text-neutral-600">{res.phone}</p>
              </div>
            </a>
            <div class="flex items-center gap-3">
              <div class="text-right">
                <p class="text-sm font-semibold text-gold">${res.amount}</p>
                <div class="flex gap-1">
                  {res.numbers.slice(0, 3).map((n) => (
                    <span class="rounded bg-dark px-1.5 py-0.5 text-[10px] text-neutral-400">{n}</span>
                  ))}
                  {res.numbers.length > 3 && (
                    <span class="rounded bg-dark px-1.5 py-0.5 text-[10px] text-neutral-500">+{res.numbers.length - 3}</span>
                  )}
                </div>
              </div>
              <ReservationActions
                reservation={res}
                onApprove={(id) => console.log('Aprobar:', id)}
                onCancel={(id, reason) => console.log('Cancelar:', id, reason)}
                client:load
              />
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="card-premium">
      <div class="border-b border-dark-border p-5">
        <h2 class="font-bold text-white">Actividad Reciente</h2>
      </div>
      <div class="divide-y divide-dark-border">
        {recentActivity.map((activity) => (
          <div class="flex items-start gap-3 p-4">
            <div class={`mt-1 flex h-2 w-2 flex-shrink-0 rounded-full ${
              activity.action.includes('aprobado') ? 'bg-green' :
              activity.action.includes('reserva') ? 'bg-amber' :
              activity.action.includes('vencida') ? 'bg-red' :
              'bg-blue'
            }`}></div>
            <div>
              <p class="text-sm font-medium text-white">{activity.action}</p>
              <p class="text-xs text-neutral-500">{activity.detail}</p>
              <p class="mt-1 text-xs text-neutral-600">{activity.time}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

</AdminLayout>
detail}</p>
                    <p class="mt-1 text-xs text-neutral-600">{activity.time}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>
