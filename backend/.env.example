# Copia este archivo a `.env` y ajusta los valores según el entorno.
# En producción (Vercel) define estas variables como environment variables.

# Django
DJANGO_SECRET_KEY=generate-a-random-64-char-secret
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,webrifas.com
DJANGO_CONN_MAX_AGE=0

# Base de datos. En local puedes omitirlo para usar SQLite.
# En producción apunta al pooler (transaction) de Supabase Postgres.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS (orígenes permitidos, separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:4321,https://webrifas.com

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
